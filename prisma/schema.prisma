generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SEEKER
  LISTER
  MODERATOR
  SCOUT
  ADMIN
}

enum ListingStatus {
  DRAFT
  PROCESSING
  IN_REVIEW
  PUBLISHED
  FLAGGED
  REJECTED
  ARCHIVED
}

enum VerificationStatus {
  UNMEASURED
  MANUAL_ESTIMATED
  AI_ESTIMATED
  SCOUT_VERIFIED
}

enum LeaseTerm {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PropertyType {
  SELF_CONTAIN
  STUDIO
  APARTMENT
  DUPLEX
  HOUSE
  SHORT_LET
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  MASTER_BEDROOM
  KITCHEN
  BATHROOM
  TOILET
  DINING_ROOM
  STUDY
  BALCONY
  COMPOUND
  HALLWAY
  STORAGE
  OTHER
}

enum CaptureMethod {
  PHOTO_REFERENCE
  PHOTO_AI
  AR_SCAN
  LIDAR_SCAN
  LASER_SCOUT
}

enum ProcessingJobKind {
  ROOM_SEGMENTATION
  CONTOUR_EXTRACTION
  DUPLICATE_CHECK
  PRICE_OUTLIER_CHECK
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FraudFlagType {
  DUPLICATE_PHOTO
  ADDRESS_MISMATCH
  PRICE_OUTLIER
  SIZE_MISMATCH
  USER_REPORT
}

enum FraudFlagStatus {
  OPEN
  REVIEWING
  CLEARED
  CONFIRMED
}

enum ModerationDecision {
  APPROVED
  REJECTED
  MORE_INFO_REQUIRED
}

enum ScoutStatus {
  APPLICANT
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum VerificationRequestStatus {
  PAYMENT_PENDING
  SCHEDULING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String
  emailVerified        Boolean               @default(false)
  image                String?
  onboardingCompletedAt DateTime?
  listerKind           String?
  companyName          String?
  preferredAreas       String[]              @default([])
  budgetMax            Decimal?              @db.Decimal(14, 2)
  preferredLeaseTerm   LeaseTerm?
  sessions             Session[]
  accounts             Account[]
  phone                String?
  avatarUrl            String?
  role                 UserRole              @default(SEEKER)
  listings             Listing[]             @relation("ListerListings")
  trustScore           TrustScore?
  scoutProfile         VerificationScout?
  savedListings        SavedListing[]
  savedSearches        SavedSearch[]
  seekerConversations  Conversation[]        @relation("SeekerConversations")
  listerConversations  Conversation[]        @relation("ListerConversations")
  sentMessages         Message[]
  moderationReviews    ModerationReview[]    @relation("ModeratorReviews")
  verificationRequests VerificationRequest[] @relation("VerificationRequester")
  reports              ListingReport[]       @relation("ReporterListingReports")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Listing {
  id                    String                @id @default(cuid())
  slug                  String                @unique
  title                 String
  description           String?
  propertyType          PropertyType
  leaseTerm             LeaseTerm
  price                 Decimal               @db.Decimal(14, 2)
  amenities             String[]              @default([])
  currency              String                @default("NGN")
  city                  String                @default("Lagos")
  areaName              String
  publicAddress         String
  privateAddress        String?
  latitude              Decimal?              @db.Decimal(10, 7)
  longitude             Decimal?              @db.Decimal(10, 7)
  bedroomCount          Int                   @default(0)
  bathroomCount         Int                   @default(0)
  totalAreaSqm          Decimal?              @db.Decimal(10, 2)
  measurementConfidence Decimal?              @db.Decimal(5, 4)
  status                ListingStatus         @default(DRAFT)
  verificationStatus    VerificationStatus    @default(UNMEASURED)
  verifiedAt            DateTime?
  lastCheckedAt         DateTime?
  viewCount             Int                   @default(0)
  listerId              String
  lister                User                  @relation("ListerListings", fields: [listerId], references: [id], onDelete: Cascade)
  rooms                 Room[]
  photos                Photo[]
  processingJobs        ProcessingJob[]
  fraudFlags            FraudFlag[]
  moderationReviews     ModerationReview[]
  savedBy               SavedListing[]
  conversations         Conversation[]
  verificationRequests  VerificationRequest[]
  reports               ListingReport[]
  publishedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([areaName, status])
  @@index([verificationStatus, status])
  @@index([price])
  @@index([totalAreaSqm])
  @@index([listerId, status])
}

model Room {
  id                    String          @id @default(cuid())
  listingId             String
  listing               Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name                  String
  roomType              RoomType
  sortOrder             Int             @default(0)
  areaSqm               Decimal?        @db.Decimal(10, 2)
  widthMeters           Decimal?        @db.Decimal(8, 3)
  lengthMeters          Decimal?        @db.Decimal(8, 3)
  heightMeters          Decimal?        @db.Decimal(8, 3)
  confidence            Decimal?        @db.Decimal(5, 4)
  captureMethod         CaptureMethod?
  boundary              Json?
  correctedBoundary     Json?
  referenceKind         String?
  referenceWidthMeters  Decimal?        @db.Decimal(8, 4)
  referenceHeightMeters Decimal?        @db.Decimal(8, 4)
  referenceCorners      Json?
  measuredAt            DateTime?
  verificationStatus    VerificationStatus @default(UNMEASURED)
  measurementHistory    RoomMeasurement[]
  correctionCount       Int             @default(0)
  photos                Photo[]
  processingJobs        ProcessingJob[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([listingId, sortOrder])
}

model Photo {
  id             String          @id @default(cuid())
  listingId      String
  listing        Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  url            String
  storageKey     String          @unique
  section        RoomType?       @default(OTHER)
  label          String?
  altText        String?
  perceptualHash String?
  sortOrder      Int             @default(0)
  width          Int?
  height         Int?
  capturedAt     DateTime?
  processingJobs ProcessingJob[]
  fraudFlags     FraudFlag[]
  measurements   RoomMeasurement[]
  createdAt      DateTime        @default(now())

  @@index([listingId, sortOrder])
  @@index([listingId, section])
  @@index([perceptualHash])
}

model ProcessingJob {
  id            String              @id @default(cuid())
  listingId     String
  listing       Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inputPhotoId  String?
  inputPhoto    Photo?              @relation(fields: [inputPhotoId], references: [id], onDelete: SetNull)
  kind          ProcessingJobKind
  status        ProcessingJobStatus @default(QUEUED)
  provider      String?
  providerJobId String?             @unique
  input         Json?
  output        Json?
  failureReason String?
  attemptCount  Int                 @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([listingId, status])
  @@index([status, createdAt])
}

model TrustScore {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score                  Decimal? @db.Decimal(5, 2)
  accuracyScore          Decimal? @db.Decimal(5, 2)
  responseScore          Decimal? @db.Decimal(5, 2)
  reliabilityScore       Decimal? @db.Decimal(5, 2)
  completedListings      Int      @default(0)
  confirmedMismatchCount Int      @default(0)
  calculatedAt           DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model FraudFlag {
  id         String          @id @default(cuid())
  listingId  String
  listing    Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  photoId    String?
  photo      Photo?          @relation(fields: [photoId], references: [id], onDelete: SetNull)
  type       FraudFlagType
  status     FraudFlagStatus @default(OPEN)
  confidence Decimal?        @db.Decimal(5, 4)
  evidence   Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status, type])
  @@index([listingId, status])
}

model ModerationReview {
  id          String             @id @default(cuid())
  listingId   String
  listing     Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  moderatorId String?
  moderator   User?              @relation("ModeratorReviews", fields: [moderatorId], references: [id], onDelete: SetNull)
  decision    ModerationDecision
  notes       String?
  createdAt   DateTime           @default(now())

  @@index([listingId, createdAt])
  @@index([moderatorId, createdAt])
}

model VerificationScout {
  id            String                @id @default(cuid())
  userId        String                @unique
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        ScoutStatus           @default(APPLICANT)
  coverageAreas String[]
  rating        Decimal?              @db.Decimal(4, 2)
  completedJobs Int                   @default(0)
  jobs          VerificationRequest[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model VerificationRequest {
  id               String                    @id @default(cuid())
  listingId        String
  listing          Listing                   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requesterId      String
  requester        User                      @relation("VerificationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  scoutId          String?
  scout            VerificationScout?        @relation(fields: [scoutId], references: [id], onDelete: SetNull)
  status           VerificationRequestStatus @default(PAYMENT_PENDING)
  scheduledFor     DateTime?
  confirmedAddress String
  fee              Decimal                   @db.Decimal(12, 2)
  currency         String                    @default("NGN")
  paymentReference String?                   @unique
  report           Json?
  completedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([listingId, status])
  @@index([scoutId, status, scheduledFor])
}

model SavedListing {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([listingId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  alertsOn  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seekerId  String
  seeker    User      @relation("SeekerConversations", fields: [seekerId], references: [id], onDelete: Cascade)
  listerId  String
  lister    User      @relation("ListerConversations", fields: [listerId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([listingId, seekerId, listerId])
  @@index([seekerId, updatedAt])
  @@index([listerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ListingReport {
  id         String    @id @default(cuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String?
  reporter   User?     @relation("ReporterListingReports", fields: [reporterId], references: [id], onDelete: SetNull)
  reason     String
  details    String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([listingId, resolvedAt])
}

// Better Auth owns credentials and opaque, revocable database sessions.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                     String    @id @default(cuid())
  accountId              String
  providerId             String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Append-only evidence retained when a room outline is corrected.
model RoomMeasurement {
  id             String        @id @default(cuid())
  roomId         String
  room           Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  photoId        String
  photo          Photo         @relation(fields: [photoId], references: [id], onDelete: Restrict)
  areaSqm        Decimal       @db.Decimal(10, 2)
  boundary       Json
  reference      Json
  captureMethod  CaptureMethod
  confidence     Decimal?      @db.Decimal(5, 4)
  correctionCount Int          @default(0)
  createdAt      DateTime      @default(now())

  @@index([roomId, createdAt])
}
